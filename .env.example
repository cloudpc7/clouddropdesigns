# Empty = same-origin /api (Vite proxy locally, CloudFront /api/* in production).
# Set to the API Gateway URL only when the SPA is hosted without that behavior.
VITE_API_BASE=

# Local Vite proxy target for /api when VITE_API_BASE is empty.
VITE_API_PROXY=http://localhost:3001

# Cloudflare Turnstile site key (public). Secret stays on the API.
VITE_TURNSTILE_SITE_KEY=
