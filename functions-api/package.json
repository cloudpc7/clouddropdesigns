{
  "name": "clouddrop-api",
  "description": "Express content API for CloudDropDesigns (Firebase Cloud Functions)",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "node src/local.js",
    "serve": "firebase emulators:start --only functions,database",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions:api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-functions": "^6.4.0",
    "googleapis": "^148.0.0",
    "nodemailer": "^6.10.1"
  }
}