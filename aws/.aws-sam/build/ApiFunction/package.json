{
    "name":  "clouddrop-api",
    "description":  "Express content API for CloudDropDesigns (AWS Lambda + local)",
    "private":  true,
    "main":  "index.js",
    "engines":  {
                    "node":  "22"
                },
    "scripts":  {
                    "start":  "node src/local.js",
                    "serve":  "firebase emulators:start --only functions,database",
                    "shell":  "firebase functions:shell",
                    "deploy":  "firebase deploy --only functions:api"
                },
    "dependencies":  {
                         "@aws-sdk/client-dynamodb":  "^3.887.0",
                         "@aws-sdk/client-secrets-manager":  "^3.1124.0",
                         "@aws-sdk/lib-dynamodb":  "^3.887.0",
                         "@codegenie/serverless-express":  "^4.17.0",
                         "cors":  "^2.8.5",
                         "express":  "^5.1.0",
                         "firebase-functions":  "^6.4.0",
                         "googleapis":  "^148.0.0",
                         "nodemailer":  "^6.10.1"
                     },
    "version":  "1.0.0"
}
